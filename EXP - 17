# Mobile Price Prediction using Random Forest Classifier

import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score

# Create the dataset
data = {
    "RAM": [2, 2, 3, 3, 4, 4, 6, 6, 8, 8, 12, 12],
    "Battery": [2500, 3000, 3000, 3500, 3500, 4000,
                4000, 4500, 4500, 5000, 5000, 6000],
    "Storage": [32, 32, 64, 64, 64, 128,
                128, 128, 256, 256, 256, 512],
    "Camera": [8, 12, 12, 16, 16, 20,
               24, 32, 32, 48, 50, 64],
    "Price_Range": [
        0, 0, 0, 1, 1, 1,
        2, 2, 2, 3, 3, 3
    ]
}

df = pd.DataFrame(data)

# Display the dataset
print("Mobile Price Dataset")
print(df)

# Select input features and target
X = df[["RAM", "Battery", "Storage", "Camera"]]
y = df["Price_Range"]

# Split the dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

# Create Random Forest Classifier
model = RandomForestClassifier(
    n_estimators=100,
    random_state=42
)

# Train the model
model.fit(X_train, y_train)

# Predict the test data
y_pred = model.predict(X_test)

# Calculate accuracy
accuracy = accuracy_score(y_test, y_pred)

print("\nMobile Price Prediction using Random Forest")
print("--------------------------------------------")
print("Accuracy:", accuracy)

# Get details of a new mobile
print("\nEnter mobile specifications:")

ram = int(input("RAM (GB): "))
battery = int(input("Battery Capacity (mAh): "))
storage = int(input("Storage (GB): "))
camera = int(input("Camera (MP): "))

# Create input data
new_mobile = [[ram, battery, storage, camera]]

# Predict price range
prediction = model.predict(new_mobile)

# Display price range
price_ranges = {
    0: "Low",
    1: "Medium",
    2: "High",
    3: "Very High"
}

print("\nPredicted Mobile Price Range:",
      price_ranges[prediction[0]])
